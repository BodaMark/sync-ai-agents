{
  "name": "agentsync",
  "version": "0.1.0",
  "description": "Unified configuration, rules, skills, and MCP sync tool for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agentsync": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BodaMark/sync-ai-agents.git"
  },
  "homepage": "https://github.com/BodaMark/sync-ai-agents#readme",
  "bugs": {
    "url": "https://github.com/BodaMark/sync-ai-agents/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node ./dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "ai-coding-agents",
    "agents",
    "agent-config",
    "cli",
    "cursor",
    "cursorrules",
    "claude-code",
    "claude-md",
    "cline",
    "opencode",
    "aider",
    "mcp",
    "mcp-sync",
    "model-context-protocol",
    "secret-scanner",
    "dotenv",
    "llm",
    "typescript",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.2"
  }
}
